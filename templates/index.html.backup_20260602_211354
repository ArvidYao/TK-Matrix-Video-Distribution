async function loadLogs() {
    try {
        const data = await api('GET', '/api/logs');
        const el = document.getElementById('logContent');
        const filterVal = document.getElementById('logLevelFilter').value;

        let lines = data.logs || [];
        if (filterVal !== 'all') {
            lines = lines.filter(l => l.includes(filterVal));
        }

        if (lines.length === 0) {
            el.textContent = '(空)';
            return;
        }

        // 高亮关键词
        const highlighted = lines.map(line => {
            let color = 'text-slate-400';
            if (line.includes('ERROR')) color = 'text-red-400';
            else if (line.includes('WARNING')) color = 'text-amber-400';
            else if (line.includes('SUCCESS') || line.includes('✅')) color = 'text-emerald-400';
            return `<span class="${color}">${escapeHtml(line)}</span>`;
        }).join('\n');

        el.innerHTML = highlighted;

        // 自动滚到底部
        el.scrollTop = el.scrollHeight;

    } catch (e) {
        document.getElementById('logContent').textContent = '加载失败: ' + e.message;
    }
}

