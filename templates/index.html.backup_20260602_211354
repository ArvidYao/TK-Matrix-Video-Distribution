                    <p class="text-xs text-slate-600 mt-1">${timeStr}</p>
                </div>`;
        });
        listEl.innerHTML = html;
    } catch (e) {
        console.error('加载文案失败:', e);
    }
}

function selectCaption(captionId) {
    selectedCaptionId = captionId;
    document.querySelectorAll('.caption-item').forEach(el => {
        el.classList.remove('bg-blue-500/10', 'border-l-2', 'border-blue-500');
    });
    const target = document.getElementById(`cap-${captionId}`);
    if (target) {
        target.classList.add('bg-blue-500/10', 'border-l-2', 'border-blue-500');
    }

    // 更新预览
    try {
        api('GET', '/api/captions').then(data => {
            const cap = (data.captions || []).find(c => c.id === captionId);
            if (cap) {
                document.getElementById('selectedCaptionPreview').innerHTML = `
                    <span class="font-medium text-blue-400">${escapeHtml(cap.name)}</span>
                    <pre class="text-xs text-slate-400 mt-1 whitespace-pre-wrap font-sans">${escapeHtml(cap.content)}</pre>`;
                updateSendButton();
            }
        });
    } catch (e) {}

    loadCaptions();
    updateSendButton();
}

function showAddCaptionForm() {
    document.getElementById('captionEditId').value = '';
    document.getElementById('captionName').value = '';
    document.getElementById('captionContent').value = '';
    document.getElementById('captionCharCount').textContent = '0';
    document.getElementById('captionForm').classList.remove('hidden');
    document.getElementById('captionName').focus();
}

function cancelCaptionForm() {
    document.getElementById('captionForm').classList.add('hidden');
    document.getElementById('captionEditId').value = '';
}

function updateCharCount() {
    const len = document.getElementById('captionContent').value.length;
    document.getElementById('captionCharCount').textContent = len + ' 字';
}

async function editCaption(captionId) {
    try {
        const data = await api('GET', '/api/captions');
        const cap = (data.captions || []).find(c => c.id === captionId);
        if (!cap) return;

        document.getElementById('captionEditId').value = cap.id;
        document.getElementById('captionName').value = cap.name;
        document.getElementById('captionContent').value = cap.content;
        document.getElementById('captionCharCount').textContent = cap.content.length + ' 字';
        document.getElementById('captionForm').classList.remove('hidden');
        document.getElementById('captionName').focus();
    } catch (e) {
        showToast('加载文案失败', 'error');
    }
}

async function saveCaption() {
    const editId = document.getElementById('captionEditId').value;
    const name = document.getElementById('captionName').value.trim();
    const content = document.getElementById('captionContent').value.trim();

    if (!name) { showToast('请输入文案名称', 'warning'); return; }
    if (!content) { showToast('请输入文案内容', 'warning'); return; }

    try {
        let res;
        if (editId) {
            res = await api('PUT', `/api/captions/${editId}`, { name, content });
        } else {
            res = await api('POST', '/api/captions', { name, content });
        }

        if (res.success) {
            showToast(editId ? '文案已更新' : '文案已创建', 'success');
            cancelCaptionForm();
            loadCaptions();
        } else {
            showToast(res.error || '操作失败', 'error');
        }
    } catch (e) {
        showToast('保存失败: ' + e.message, 'error');
    }
}

async function deleteCaptionConfirm(captionId, name) {
    if (!confirm(`确定要删除文案「${name}」吗？此操作不可撤销。`)) return;

    try {
        const res = await api('DELETE', `/api/captions/${captionId}`);
        if (res.success) {
            if (selectedCaptionId === captionId) {
                selectedCaptionId = null;
                document.getElementById('selectedCaptionPreview').innerHTML =
                    '<span class="text-sm text-slate-500 italic">请在左侧点击选择一条文案</span>';
                updateSendButton();
            }
            showToast('文案已删除', 'success');
            loadCaptions();
        } else {
            showToast(res.error || '删除失败', 'error');
        }
    } catch (e) {
        showToast('删除失败: ' + e.message, 'error');
    }
}

function updateSendButton() {
    const btn = document.getElementById('btnSendCaption');
    if (selectedCaptionId) {
        btn.disabled = false;
        btn.className = 'w-full bg-blue-600 hover:bg-blue-500 text-white py-3 rounded-lg font-medium text-sm transition-colors';
    } else {
        btn.disabled = true;
        btn.className = 'w-full bg-slate-700 text-slate-500 cursor-not-allowed py-3 rounded-lg font-medium text-sm';
    }
}

async function sendCaptionToDevice() {
    if (!selectedCaptionId) {
        showToast('请先在左侧选择一条文案', 'warning');
        return;
    }

    const btn = document.getElementById('btnSendCaption');
    btn.disabled = true;
    btn.innerHTML = '<span class="spin inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full mr-2"></span>调起 AirDrop...';

    try {
        const res = await api('POST', '/api/captions/send', {
            caption_id: selectedCaptionId
        });

        const resultEl = document.getElementById('captionSendResult');
        resultEl.classList.remove('hidden');

        if (res.success) {
            resultEl.className = 'mt-4 p-4 rounded-lg bg-blue-500/10 border border-blue-500/20 text-sm';
            resultEl.innerHTML = `
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-blue-400 font-medium">✈️ AirDrop 已调起</span>
                </div>
                <p class="text-xs text-slate-300">文案「${escapeHtml(res.caption_name)}」已准备好发送</p>
                <p class="text-xs text-slate-500 mt-1">请在 AirDrop 面板中点击目标设备，iPhone 端点击「接受」即可</p>
            `;
            showToast('AirDrop 已调起，请在面板中选择设备', 'success', 5000);
        } else {
            resultEl.className = 'mt-4 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-sm';
            resultEl.innerHTML = `<p class="text-red-400 text-sm">❌ ${escapeHtml(res.error || '发送失败')}</p>`;
            showToast(res.error || '发送失败', 'error');
        }
    } catch (e) {
        showToast('发送异常: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '✈️ 通过 AirDrop 发送文案';
        updateSendButton();
    }
}

