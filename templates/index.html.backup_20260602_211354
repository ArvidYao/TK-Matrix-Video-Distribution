function startScraper() {
    var hashtagsText = document.getElementById('scraperHashtags').value.trim();
    var hashtags = hashtagsText ? hashtagsText.split('\n').map(s => s.trim()).filter(s => s) : [];

    if (hashtags.length === 0) {
        alert('请输入至少一个搜索标签');
        return;
    }

    var payload = {
        hashtags: hashtags,
        ms_token: document.getElementById('scraperToken').value.trim(),
        proxy: document.getElementById('scraperProxy').value.trim(),
        min_plays: parseInt(document.getElementById('scraperMinPlays').value) || 100000,
        min_duration: parseInt(document.getElementById('scraperMinDuration').value) || 70,
    };

    scraperRunning = true;
    document.getElementById('btnScraperStart').classList.add('hidden');
    document.getElementById('btnScraperStop').classList.remove('hidden');
    document.getElementById('scraperStatus').textContent = '启动中...';
    document.getElementById('scraperLogPanel').classList.remove('hidden');
    document.getElementById('scraperLog').innerHTML = '';
    document.getElementById('scraperResultsPanel').classList.add('hidden');

    fetch('/api/scraper/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload),
    })
    .then(r => r.json())
    .then(data => {
        if (data.error) {
            scraperRunning = false;
            document.getElementById('scraperStatus').textContent = '启动失败: ' + data.error;
            document.getElementById('btnScraperStart').classList.remove('hidden');
            document.getElementById('btnScraperStop').classList.add('hidden');
            alert(data.error);
        } else {
            document.getElementById('scraperStatus').textContent = '运行中 (' + data.hashtags.length + ' 个标签)';
            connectScraperSSE();
        }
    })
    .catch(err => {
        scraperRunning = false;
        document.getElementById('scraperStatus').textContent = '网络错误';
        document.getElementById('btnScraperStart').classList.remove('hidden');
        document.getElementById('btnScraperStop').classList.add('hidden');
    });
}

function stopScraper() {
    fetch('/api/scraper/stop', {method: 'POST'})
    .then(r => r.json())
    .then(() => {
        document.getElementById('scraperStatus').textContent = '正在停止...';
    });
}

function connectScraperSSE() {
    if (scraperES) scraperES.close();

    scraperES = new EventSource('/api/scraper/progress');

    function addLog(msg, type) {
        var el = document.getElementById('scraperLog');
        var line = document.createElement('div');
        var colorClass = 'text-slate-400';
        if (type === 'success') colorClass = 'text-emerald-400';
        else if (type === 'error' || type === 'warning') colorClass = 'text-red-400';
        else if (type === 'info') colorClass = 'text-blue-400';
        else if (type === 'highlight') colorClass = 'text-amber-400';
        line.className = colorClass;
        line.textContent = msg;
        el.appendChild(line);
        el.scrollTop = el.scrollHeight;
    }

    scraperES.onmessage = function(event) {
        var data = JSON.parse(event.data);

        if (data.type === 'heartbeat') return;

        switch (data.type) {
            case 'connected':
                addLog('已连接进度推送', 'info');
                break;
            case 'start':
                addLog('开始爬取 ' + data.hashtags.length + ' 个标签...', 'info');
                break;
            case 'browser_launch':
                addLog('启动 Chrome 浏览器...', 'info');
                break;
            case 'home_loading':
                addLog('访问 TikTok 首页建立 session...', 'info');
                break;
            case 'login_required':
                addLog('⚠️ 需要登录！请在弹出的浏览器中手动登录 TikTok', 'warning');
                break;
            case 'waf_wait':
                addLog('WAF 验证中，等待...', 'warning');
                break;
            case 'progress':
                var pct = Math.round((data.current / data.total) * 100);
                document.getElementById('scraperProgressBar').classList.remove('hidden');
                document.getElementById('scraperProgressFill').style.width = pct + '%';
                addLog('[' + data.current + '/' + data.total + '] ' + data.hashtag, 'info');
                break;
            case 'hashtag_start':
                addLog('搜索 #' + data.hashtag + '...', 'highlight');
                break;
            case 'hashtag_scroll':
                addLog('  滚动 ' + data.scroll + '/' + data.max_scrolls + '，已捕获 ' + data.captured + ' 条', 'text');
                break;
            case 'hashtag_done':
                addLog('  #' + data.hashtag + ' 完成，获取 ' + data.count + ' 条', 'success');
                break;
            case 'hashtag_error':
                addLog('  #' + data.hashtag + ' 失败: ' + data.error, 'error');
                break;
            case 'browser_close':
                addLog('浏览器已关闭', 'info');
                break;
            case 'complete':
                addLog('✅ 完成！共 ' + data.total + ' 条，符合条件 ' + data.qualified + ' 条（' + data.elapsed + 's）', 'success');
                document.getElementById('scraperStatus').textContent = '完成';
                document.getElementById('btnScraperStart').classList.remove('hidden');
                document.getElementById('btnScraperStop').classList.add('hidden');
                document.getElementById('scraperProgressBar').classList.add('hidden');
                scraperRunning = false;
                if (scraperES) scraperES.close();
                loadScraperResults();
                break;
            case 'error':
                addLog('❌ 错误: ' + data.message, 'error');
                document.getElementById('scraperStatus').textContent = '错误';
                document.getElementById('btnScraperStart').classList.remove('hidden');
                document.getElementById('btnScraperStop').classList.add('hidden');
                scraperRunning = false;
                if (scraperES) scraperES.close();
                break;
            case 'stopped':
                addLog('已手动停止', 'warning');
                document.getElementById('scraperStatus').textContent = '已停止';
                document.getElementById('btnScraperStart').classList.remove('hidden');
                document.getElementById('btnScraperStop').classList.add('hidden');
                scraperRunning = false;
                if (scraperES) scraperES.close();
                break;
        }
    };

    scraperES.onerror = function() {
        // SSE 会自动重连
    };
}

function formatPlayCount(num) {
    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
    if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
    return num.toString();
}

// ── 结果数据全局 ──
var currentResultTab = 'all';     // 'all' | 'qualified'
var currentResultsData = [];       // 当前表格中展示的数据
var allResultsCache = null;        // API 返回的原始数据缓存

function switchResultTab(tab) {
    currentResultTab = tab;
    // 更新 Tab 按钮样式
    var allBtn = document.getElementById('tabAllBtn');
    var qualBtn = document.getElementById('tabQualifiedBtn');
    if (tab === 'all') {
        allBtn.className = 'px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-blue-600 text-white';
        qualBtn.className = 'px-3 py-1.5 rounded-md text-xs font-medium transition-all text-slate-400 hover:text-slate-200';
        document.getElementById('scraperResultTitle').textContent = '搜索结果';
    } else {
        qualBtn.className = 'px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-blue-600 text-white';
