// ============================================================
// 全局状态
// ============================================================
let currentPage = 'dashboard';
let isRunning = false;
let eventSource = null;
let currentTaskId = null;  // 当前任务ID，用于过滤旧消息

// ============================================================
// 页面导航
// ============================================================
function showPage(pageName) {
    // 隐藏所有页面
    document.querySelectorAll('.page').forEach(el => el.classList.add('hidden'));
    // 显示目标页面
    const target = document.getElementById(`page-${pageName}`);
    if (target) {
        target.classList.remove('hidden');
        target.classList.remove('fade-in');
        void target.offsetWidth; // 强制重绘
        target.classList.add('fade-in');
    }

    // 更新导航高亮
    document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));
    const activeNav = document.querySelector(`[data-page="${pageName}"]`);
    if (activeNav) activeNav.classList.add('active');

    currentPage = pageName;

    // 页面切换时的数据刷新
    if (pageName === 'dashboard') refreshDashboard();
    if (pageName === 'devices') scanDevices();
    if (pageName === 'videos') refreshVideos();
    if (pageName === 'captions') { loadCaptions(); }
    if (pageName === 'scraper') { loadScraperStatus(); }
    if (pageName === 'history') loadHistory();
    if (pageName === 'logs') loadLogs();
    if (pageName === 'settings') loadSettings();
}

