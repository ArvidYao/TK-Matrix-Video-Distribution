function loadScraperResults(tab) {
    tab = tab || currentResultTab || 'all';
    fetch('/api/scraper/results')
    .then(function(r) { return r.json(); })
    .then(function(data) {
        allResultsCache = data;
        var results = (tab === 'all') ? (data.all_results || []) : (data.results || data.qualified || []);
        currentResultsData = results;
        document.getElementById('scraperResultCount').textContent = results.length;
        document.getElementById('scraperResultsPanel').classList.remove('hidden');
        document.getElementById('selectAllCheckbox').checked = false;
        updateSelectedCount();

        var tbody = document.getElementById('scraperResultsBody');
        tbody.innerHTML = '';

        if (results.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="px-4 py-8 text-center text-slate-500 text-xs">暂无数据</td></tr>';
            return;
        }

        results.forEach(function(v, i) {
            var tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-700/30 transition-colors';
            tr.innerHTML =
                '<td class="px-3 py-3 text-center" onclick="event.stopPropagation()">' +
                    '<input type="checkbox" class="result-checkbox w-4 h-4 rounded border-slate-500 bg-slate-700 text-blue-500 focus:ring-blue-500 focus:ring-offset-0" data-index="' + i + '" onchange="updateSelectedCount()">' +
                '</td>' +
                '<td class="px-3 py-3 text-xs text-slate-500 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + (i + 1) + '</td>' +
                '<td class="px-3 py-3 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])"><span class="px-2 py-0.5 text-xs rounded bg-blue-500/20 text-blue-300">#' + (v.hashtag || '') + '</span></td>' +
                '<td class="px-3 py-3 text-xs text-slate-300 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">@' + (v.author || '') + '</td>' +
                '<td class="px-3 py-3 text-xs text-slate-400 max-w-[180px] truncate cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + (v.description || '').substring(0, 50) + '</td>' +
                '<td class="px-3 py-3 text-right text-xs font-medium text-emerald-400 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + formatPlayCount(v.plays) + '</td>' +
                '<td class="px-3 py-3 text-right text-xs text-slate-400 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + formatPlayCount(v.likes) + '</td>' +
                '<td class="px-3 py-3 text-right text-xs text-slate-400 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + formatPlayCount(v.comments) + '</td>' +
                '<td class="px-3 py-3 text-right text-xs text-slate-300 cursor-pointer" onclick="openVideoDetail(currentResultsData[' + i + '])">' + (v.duration_display || '0:00') + '</td>' +
                '<td class="px-3 py-3" onclick="event.stopPropagation()"><a href="' + v.video_url + '" target="_blank" class="text-blue-400 hover:text-blue-300 text-xs">打开 ↗</a></td>';
            tbody.appendChild(tr);
        });
    });
}

// ── 批量选择/下载 ──
var currentSaveDir = '';  // 用户自定义保存目录

function toggleSelectAll(checked) {
    var checkboxes = document.querySelectorAll('.result-checkbox');
    checkboxes.forEach(function(cb) { cb.checked = checked; });
    updateSelectedCount();
}

function updateSelectedCount() {
    var checkboxes = document.querySelectorAll('.result-checkbox');
    var count = 0;
    checkboxes.forEach(function(cb) { if (cb.checked) count++; });
    document.getElementById('selectedCount').textContent = count;
    var btn = document.getElementById('batchDownloadBtn');
    if (count > 0) {
        btn.disabled = false;
    } else {
        btn.disabled = true;
    }
}

function getSelectedVideos() {
    var checkboxes = document.querySelectorAll('.result-checkbox');
    var selected = [];
    checkboxes.forEach(function(cb) {
        if (cb.checked) {
            var idx = parseInt(cb.getAttribute('data-index'));
            if (idx >= 0 && idx < currentResultsData.length) {
                selected.push(currentResultsData[idx]);
            }
        }
    });
    return selected;
}

function chooseDownloadDir() {
    fetch('/api/scraper/video/choose-dir', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success && data.path) {
            currentSaveDir = data.path;
            localStorage.setItem('tk_save_dir', currentSaveDir);
            document.getElementById('saveDirIndicator').classList.remove('hidden');
            document.getElementById('saveDirPath').textContent = currentSaveDir;
            document.getElementById('chooseDirLabel').textContent = '更改目录';
        }
    })
    .catch(function(err) {
        alert('选择目录失败: ' + err.message);
    });
}

// 页面加载时恢复保存目录
(function() {
    var saved = localStorage.getItem('tk_save_dir');
    if (saved) {
        currentSaveDir = saved;
        document.getElementById('saveDirIndicator').classList.remove('hidden');
        document.getElementById('saveDirPath').textContent = currentSaveDir;
