<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TK 视频分发工具</title>
    <link rel="icon" type="image/png" href="/ico.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* 自定义滚动条 */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #1e293b; border-radius: 3px; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }

        /* 动画 */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in { animation: fadeIn 0.3s ease-out; }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 5px rgba(59,130,246,0.4); }
            50% { box-shadow: 0 0 20px rgba(59,130,246,0.7); }
        }
        .pulse-running { animation: pulse-glow 2s ease-in-out infinite; }

        @keyframes spin { to { transform: rotate(360deg); } }
        .spin { animation: spin 1s linear infinite; }

        /* 进度条动画 */
        .progress-bar { transition: width 0.5s ease-in-out; }

        /* 标签历史点击交互 */
        @keyframes tagPop {
            0% { transform: scale(1); }
            40% { transform: scale(1.12); }
            100% { transform: scale(1); }
        }
        .history-tag {
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
            user-select: none;
        }
        .history-tag:hover {
            filter: brightness(1.2);
        }
        .history-tag.active {
            background-color: rgba(59, 130, 246, 0.25);
            color: #93c5fd;
            border-color: rgba(59, 130, 246, 0.5);
        }
        .history-tag.inactive {
            background-color: rgba(100, 116, 139, 0.15);
            color: #94a3b8;
            border-color: rgba(100, 116, 139, 0.25);
        }
        .history-tag.popping {
            animation: tagPop 0.3s ease-out;
        }
        .history-tag .tag-icon {
            transition: opacity 0.15s ease;
        }

        /* 导航激活状态 */
        .nav-item.active {
            background: rgba(59,130,246,0.15);
            border-left: 3px solid #3b82f6;
            color: #60a5fa;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-200 min-h-screen">
    <!-- 顶部导航栏 -->
    <header class="bg-slate-800/80 backdrop-blur-sm border-b border-slate-700 sticky top-0 z-50">
        <div class="flex items-center justify-between px-6 py-3">
            <div class="flex items-center gap-3">
                <span class="text-2xl">🎬</span>
                <h1 class="text-xl font-bold text-white">TK 视频分发工具</h1>
                <span class="px-2 py-0.5 text-xs rounded bg-slate-700 text-slate-400 font-mono">v1.1.2</span>
                <span id="statusBadge" class="hidden px-2 py-0.5 text-xs rounded-full font-medium bg-emerald-500/20 text-emerald-400">就绪</span>
            </div>
            <div class="flex items-center gap-4">
                <button onclick="showGuide()" class="text-sm text-slate-400 hover:text-white transition-colors">
                    📖 使用说明
                </button>
                <button onclick="showChangelog()" class="text-sm text-slate-400 hover:text-white transition-colors">
                    📋 更新日志
                </button>
                <button onclick="showPage('settings')" class="text-sm text-slate-400 hover:text-white transition-colors">
                    ⚙️ 设置
                </button>
                <div class="w-px h-5 bg-slate-700"></div>
                <span id="currentTime" class="text-xs text-slate-500 font-mono"></span>
            </div>
        </div>
    </header>

    <div class="flex h-[calc(100vh-57px)]">
        <!-- 左侧导航 -->
        <nav class="w-56 bg-slate-800/50 border-r border-slate-700 flex-shrink-0 p-3 flex flex-col">
            <div class="space-y-1">
                <button onclick="showPage('dashboard')" data-page="dashboard" class="nav-item active w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    📊 仪表盘
                </button>
                <button onclick="showPage('distribute')" data-page="distribute" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    🚀 分发执行
                </button>
                <button onclick="showPage('devices')" data-page="devices" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    📱 设备管理
                </button>
                <button onclick="showPage('videos')" data-page="videos" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    🎞️ 视频管理
                </button>
                <button onclick="showPage('captions')" data-page="captions" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    📝 文案分发
                </button>
                <button onclick="showPage('scraper')" data-page="scraper" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    🔍 爆款素材
                </button>
                <button onclick="showPage('history')" data-page="history" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    📋 历史记录
                </button>
                <button onclick="showPage('logs')" data-page="logs" class="nav-item w-full text-left px-4 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-all">
                    📝 日志
                </button>

                <div class="pt-4 mt-4 border-t border-slate-700">
                    <p class="px-4 text-xs text-slate-500 mb-2">快捷操作</p>
                    <button onclick="quickScanDevices()" class="w-full text-left px-4 py-2 rounded-lg text-xs text-slate-500 hover:text-blue-400 hover:bg-slate-700/30 transition-all">
                        🔍 扫描设备
                    </button>
                    <button onclick="refreshVideos()" class="w-full text-left px-4 py-2 rounded-lg text-xs text-slate-500 hover:text-blue-400 hover:bg-slate-700/30 transition-all">
                        🔄 刷新视频
                    </button>
                </div>
            </div>

            <!-- 作者信息 - 推到底部 -->
            <div class="mt-auto pt-3 border-t border-slate-700/50">
                <p class="px-3 text-xs text-slate-600">作者：姐夫</p>
            </div>
        </nav>

        <!-- 主内容区 -->
        <main class="flex-1 overflow-y-auto p-6">
            <!-- ====== 仪表盘页面 ====== -->
            <div id="page-dashboard" class="page fade-in">
                <h2 class="text-lg font-semibold text-white mb-5">仪表盘</h2>

                <!-- 状态卡片 -->
                <div class="grid grid-cols-4 gap-4 mb-6">
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs text-slate-400">已连接设备</span>
                            <span class="text-lg">📱</span>
                        </div>
                        <p id="dash-devices" class="text-3xl font-bold text-white">--</p>
                    </div>
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs text-slate-400">待分发视频</span>
                            <span class="text-lg">🎬</span>
                        </div>
                        <p id="dash-videos" class="text-3xl font-bold text-white">--</p>
                    </div>
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs text-slate-400">今日分发次数</span>
                            <span class="text-lg">📈</span>
                        </div>
                        <p id="dash-today" class="text-3xl font-bold text-white">0</p>
                    </div>
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs text-slate-400">累计分发视频</span>
                            <span class="text-lg">✅</span>
                        </div>
                        <p id="dash-total" class="text-3xl font-bold text-emerald-400">0</p>
                    </div>
                </div>

                <!-- 快捷操作区 + 最近记录 -->
                <div class="grid grid-cols-2 gap-6">
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <h3 class="text-sm font-medium text-slate-300 mb-4">快速开始</h3>
                        <div class="space-y-3">
                            <button onclick="showPage('distribute')" class="w-full bg-blue-600 hover:bg-blue-500 text-white py-3 px-4 rounded-lg font-medium text-sm transition-colors flex items-center justify-center gap-2">
                                <span>🚀</span> 开始分发
                            </button>
                            <div class="grid grid-cols-2 gap-3">
                                <button onclick="quickScanDevices()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 py-2 px-3 rounded-lg text-xs transition-colors">
                                    🔍 扫描设备
                                </button>
                                <button onclick="refreshVideos()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 py-2 px-3 rounded-lg text-xs transition-colors">
                                    🎞 刷新视频
                                </button>
                                <button onclick="showPage('settings')" class="bg-slate-700 hover:bg-slate-600 text-slate-200 py-2 px-3 rounded-lg text-xs transition-colons">
                                    ⚙️ 修改设置
                                </button>
                                <button onclick="showPage('history')" class="bg-slate-700 hover:bg-slate-600 text-slate-200 py-2 px-3 rounded-lg text-xs transition-colors">
                                    📋 查看历史
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-800 rounded-xl p-5 border border-slate-700">
                        <h3 class="text-sm font-medium text-slate-300 mb-4">最近一次分发</h3>
                        <div id="dash-last-session">
                            <p class="text-sm text-slate-500 text-center py-8">暂无记录</p>
                        </div>
                    </div>
                </div>

                <!-- 今日统计图表区域 -->
                <div class="mt-6 bg-slate-800 rounded-xl p-5 border border-slate-700">
                    <h3 class="text-sm font-medium text-slate-300 mb-4">今日概览</h3>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="text-center p-4 bg-slate-900/50 rounded-lg">
                            <p id="dash-today-success" class="text-2xl font-bold text-emerald-400">0</p>
                            <p class="text-xs text-slate-500 mt-1">成功设备数</p>
                        </div>
                        <div class="text-center p-4 bg-slate-900/50 rounded-lg">
                            <p id="dash-today-fail" class="text-2xl font-bold text-red-400">0</p>
                            <p class="text-xs text-slate-500 mt-1">失败设备数</p>
                        </div>
                        <div class="text-center p-4 bg-slate-900/50 rounded-lg">
                            <p id="dash-video-size" class="text-2xl font-bold text-blue-400">0 MB</p>
                            <p class="text-xs text-slate-500 mt-1">待分发总大小</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ====== 分发执行页面 ====== -->
            <div id="page-distribute" class="page hidden fade-in">
                <h2 class="text-lg font-semibold text-white mb-5">分发执行</h2>

                <!-- 控制面板 -->
                <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 mb-6">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-3">
                                <label class="flex items-center gap-2 cursor-pointer select-none">
                                    <input type="checkbox" id="dryRunToggle" class="w-4 h-4 rounded border-slate-600 bg-slate-700 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-800">
                                    <span class="text-sm text-slate-300">模拟运行（Dry-Run）</span>
                                </label>
                                <span class="text-xs text-slate-500 bg-slate-700 px-2 py-1 rounded">不实际传输和删除文件</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <button id="btnStart" onclick="startDistribute()" class="bg-blue-600 hover:bg-blue-500 disabled:hover:bg-blue-600 disabled:opacity-50 text-white py-2.5 px-6 rounded-lg font-medium text-sm transition-colors">
                                ▶️ 开始分发
                            </button>
                            <button id="btnStop" onclick="stopDistribute()" hidden class="bg-red-600 hover:bg-red-500 text-white py-2.5 px-6 rounded-lg font-medium text-sm transition-colors pulse-running">
                                ⏹ 停止
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 实时进度 -->
                <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-slate-300">实时进度</h3>
                        <span id="progressStatus" class="text-xs text-slate-500">等待开始...</span>
                    </div>

                    <!-- 总进度条 -->
                    <div class="mb-6">
                        <div class="flex justify-between text-xs text-slate-400 mb-2">
                            <span id="progressLabel">总体进度</span>
                            <span id="progressPercent">0%</span>
                        </div>
                        <div class="w-full h-3 bg-slate-700 rounded-full overflow-hidden">
                            <div id="progressBar" class="progress-bar h-full bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- 当前阶段消息 -->
                    <div id="currentPhaseMsg" class="text-sm text-blue-400 mb-4 p-3 bg-blue-500/10 rounded-lg border border-blue-500/20 hidden"></div>

                    <!-- 设备进度列表 -->
                    <div id="deviceProgressList" class="space-y-2 max-h-[550px] overflow-y-auto pr-1">
                        <p class="text-sm text-slate-500 text-center py-6">等待启动分发任务...</p>
                    </div>
                </div>

                <!-- 完成总结（完成后显示） -->
                <div id="completeSummary" class="hidden bg-gradient-to-br from-emerald-500/10 to-cyan-500/10 rounded-xl p-6 border border-emerald-500/20 fade-in">
                    <h3 class="text-base font-semibold text-emerald-400 mb-4 flex items-center gap-2">
                        ✅ 分发完成！
                    </h3>
                    <div class="grid grid-cols-4 gap-4" id="summaryCards">
                    </div>
                </div>
            </div>

            <!-- ====== 设备管理页面 ====== -->
            <div id="page-devices" class="page hidden fade-in">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-lg font-semibold text-white">设备管理</h2>
                    <div class="flex items-center gap-3">
                        <button onclick="forceRescanPhotos()" id="btnRescanPhotos" class="bg-purple-600/80 hover:bg-purple-500 text-white py-2 px-4 rounded-lg text-sm transition-colors flex items-center gap-2">
                            <span id="rescanSpinner" class="hidden spin">⏳</span> 📸 强制重建相册索引
                        </button>
                        <button onclick="scanDevices()" class="bg-blue-600 hover:bg-blue-500 text-white py-2 px-4 rounded-lg text-sm transition-colors flex items-center gap-2">
                            <span id="scanSpinner" class="hidden spin">⏳</span> 扫描设备
                        </button>
                    </div>
                </div>

                <!-- 相册索引说明 -->
                <div class="mb-5 bg-purple-500/10 border border-purple-500/20 rounded-xl p-4">
                    <p class="text-sm text-purple-300 font-medium mb-1">📸 强制重建相册索引</p>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        如果视频已成功上传到 iPhone 但照片 App 看不到，点击此按钮。
                        它会重命名 iOS 的 Photos.sqlite 数据库并触发系统重建，
                        使 DCIM 目录中的视频文件出现在相册中。<span class="text-amber-400">（操作安全：只是重命名不是删除，iOS 会自动重建数据库）</span>
                    </p>
                </div>

                <div id="deviceList" class="space-y-2">
                    <div class="text-center py-16">
                        <p class="text-5xl mb-3">📱</p>
                        <p class="text-slate-500">点击「扫描设备」检测连接的 iPhone</p>
                        <p class="text-xs text-slate-600 mt-2">请确保手机已通过 USB 连接并信任此电脑</p>
                    </div>
                </div>
            </div>

            <!-- ====== 视频管理页面 ====== -->
            <div id="page-videos" class="page hidden fade-in">
                <div class="flex items-center justify-between mb-5">
                    <div class="flex items-center gap-4">
                        <h2 class="text-lg font-semibold text-white">视频管理</h2>
                        <span id="videoDirBadge" class="text-xs text-slate-500 bg-slate-700 px-2 py-1 rounded"></span>
                    </div>
                    <button onclick="refreshVideos()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 py-2 px-4 rounded-lg text-sm transition-colors flex items-center gap-2">
                        🔄 刷新
                    </button>
                </div>

                <!-- 视频统计 -->
                <div class="grid grid-cols-3 gap-4 mb-5">
                    <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
                        <p class="text-xs text-slate-400">视频数量</p>
                        <p id="videoCount" class="text-2xl font-bold text-white mt-1">0</p>
                    </div>
                    <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
                        <p class="text-xs text-slate-400">总大小</p>
                        <p id="videoTotalSize" class="text-2xl font-bold text-blue-400 mt-1">0 B</p>
                    </div>
                    <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
                        <p class="text-xs text-slate-400">目录路径</p>
                        <p id="videoDirPath" class="text-xs font-mono text-slate-400 mt-1 truncate">-</p>
                    </div>
                </div>

                <!-- 视频列表 -->
                <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-700/50 text-slate-400 text-xs uppercase tracking-wider">
                            <tr>
                                <th class="text-left px-4 py-3">#</th>
                                <th class="text-left px-4 py-3">文件名</th>
                                <th class="text-right px-4 py-3">大小</th>
                                <th class="text-right px-4 py-3">修改时间</th>
                                <th class="text-center px-4 py-3">操作</th>
                            </tr>
                        </thead>
                        <tbody id="videoTableBody" class="divide-y divide-slate-700/50">
                            <tr><td colspan="5" class="text-center py-10 text-slate-500">暂无待分发视频</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ====== 文案分发页面 ====== -->
            <div id="page-captions" class="page hidden fade-in">
                <h2 class="text-lg font-semibold text-white mb-5">文案分发</h2>

                <!-- 左侧文案管理 + 右侧 AirDrop 发送 -->
                <div class="grid grid-cols-2 gap-6">
                    <!-- 文案管理区 -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
                        <div class="px-5 py-4 border-b border-slate-700 flex items-center justify-between">
                            <h3 class="text-sm font-medium text-slate-300">📝 文案列表</h3>
                            <button onclick="showAddCaptionForm()" class="bg-emerald-600 hover:bg-emerald-500 text-white py-1.5 px-3 rounded-lg text-xs font-medium transition-colors">
                                + 新建文案
                            </button>
                        </div>

                        <!-- 添加/编辑文案表单 -->
                        <div id="captionForm" class="hidden px-5 py-4 border-b border-slate-700 bg-slate-900/50">
                            <input type="hidden" id="captionEditId" value="">
                            <label class="block text-xs text-slate-400 mb-1">文案名称</label>
                            <input type="text" id="captionName" placeholder="如：文案一、搞笑风格、产品介绍..."
                                   class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-sm text-slate-200 mb-3 focus:outline-none focus:border-emerald-500">
                            <label class="block text-xs text-slate-400 mb-1">文案内容 <span id="captionCharCount" class="text-slate-600">0</span></label>
                            <textarea id="captionContent" rows="4" placeholder="输入 TikTok 文案内容...&#10;支持换行、话题标签 #hashtag、emoji 😊"
                                      class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-sm text-slate-200 resize-none focus:outline-none focus:border-emerald-500"
                                      oninput="updateCharCount()"></textarea>
                            <div class="flex justify-end gap-2 mt-3">
                                <button onclick="cancelCaptionForm()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 py-1.5 px-4 rounded-lg text-xs transition-colors">
                                    取消
                                </button>
                                <button onclick="saveCaption()" class="bg-emerald-600 hover:bg-emerald-500 text-white py-1.5 px-4 rounded-lg text-xs font-medium transition-colors">
                                    💾 保存
                                </button>
                            </div>
                        </div>

                        <!-- 文案列表 -->
                        <div id="captionList" class="max-h-[360px] overflow-y-auto divide-y divide-slate-700/50">
                            <div class="text-center py-10">
                                <p class="text-4xl mb-2">📝</p>
                                <p class="text-sm text-slate-500">暂无文案，点击「新建文案」创建</p>
                            </div>
                        </div>
                    </div>

                    <!-- AirDrop 发送区 -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
                        <div class="px-5 py-4 border-b border-slate-700">
                            <h3 class="text-sm font-medium text-slate-300">✈️ AirDrop 发送</h3>
                        </div>

                        <!-- 已选文案预览 -->
                        <div class="px-5 py-3 bg-slate-900/50 border-b border-slate-700/50">
