                        <span class="${last.fail_count > 0 ? 'text-amber-400' : 'text-emerald-400'}">
                            ✅ ${last.success_count} / ❌ ${last.fail_count}
                        </span>
                    </div>
                </div>`;
        }

        // 同时获取设备数量
        const devRes = await api('GET', '/api/devices');
        document.getElementById('dash-devices').textContent = devRes.count || 0;

    } catch (e) {
        console.error('Dashboard 刷新失败:', e);
