function onTaskStarted() {
    document.getElementById('btnStart').disabled = true;
    document.getElementById('btnStart').classList.add('opacity-50');
    document.getElementById('btnStop').hidden = false;
    document.getElementById('statusBadge').textContent = '运行中';
    document.getElementById('statusBadge').className = 'px-2 py-0.5 text-xs rounded-full font-medium bg-blue-500/20 text-blue-400 animate-pulse';

    // 重置当前任务ID（防止旧消息被误当作当前任务处理）
    currentTaskId = null;

    // 重置进度 UI
    document.getElementById('progressBar').style.width = '0%';
    document.getElementById('progressPercent').textContent = '0%';
    document.getElementById('progressStatus').textContent = '正在初始化...';
    document.getElementById('completeSummary').classList.add('hidden');
    // 清空上一批设备的进度列表
    document.getElementById('deviceProgressList').innerHTML = '';
    showPhaseMessage('正在准备...');
}

function onTaskEnded() {
    isRunning = false;
    document.getElementById('btnStart').disabled = false;
    document.getElementById('btnStart').classList.remove('opacity-50');
    document.getElementById('btnStop').hidden = true;
    document.getElementById('statusBadge').textContent = '就绪';
    document.getElementById('statusBadge').className = 'px-2 py-0.5 text-xs rounded-full font-medium bg-emerald-500/20 text-emerald-400';

    if (eventSource) {
        eventSource.close();
        eventSource = null;
    }
}

// ============================================================
// SSE 实时进度
// ============================================================
function connectSSE() {
    eventSource = new EventSource('/api/distribute/progress');

    eventSource.onmessage = (e) => {
        try {
            const msg = JSON.parse(e.data);
            handleProgressMessage(msg);
        } catch {}
    };

    eventSource.onerror = () => {
        console.log('SSE 断开或结束');
        if (eventSource) eventSource.close();
    };
}

function handleProgressMessage(msg) {
    // 过滤旧任务的消息（task_id 不匹配时忽略，但 connected/heartbeat 始终处理）
    if (currentTaskId && msg.task_id && msg.task_id !== currentTaskId
        && msg.type !== 'connected' && msg.type !== 'heartbeat') {
        return;
    }
    switch (msg.type) {
        case 'connected':
            break;

        case 'task_start':
        case 'detecting':
            showPhaseMessage(msg.message || '正在扫描设备...');
            setProgress(5);
            break;

        case 'devices_detected':
            showPhaseMessage(`${msg.message} | 检测到 ${msg.device_count || 0} 台设备`);
            setProgress(15);
            addDeviceProgressItems(msg.devices || [], msg.device_count || 0);
            break;

        case 'clearing_device':
            showPhaseMessage(msg.message || '正在清空设备旧视频...');
            setProgress(20);
            break;

        case 'device_cleared':
            showPhaseMessage(`🧹 ${msg.device_name}: 清理 ${msg.deleted || 0} 个视频`);
            break;

        case 'clearing_done':
            showPhaseMessage(msg.message || '设备清空完成');
            setProgress(25);
            break;

        case 'allocating':
            showPhaseMessage(msg.message || '正在分配视频...');
            setProgress(25);
            break;

        case 'allocated':
            showPhaseMessage(msg.message);
            setProgress(35);
            break;

        case 'uploading':
            showPhaseMessage('正在传输到各设备...');
            setProgress(40);
            break;

        case 'device_start': {
            const pct = Math.floor(40 + (msg.current / msg.total) * 40);
            setProgress(pct, `${msg.current}/${msg.total}`);
            updateDeviceItem(msg.device_udid, 'uploading', null, msg.videos || []);
            showPhaseMessage(`[${msg.current}/${msg.total}] 正在上传到 ${msg.device_name || msg.device_uid}...`);
            break;
        }

        case 'device_done': {
            const pct = Math.floor(40 + (msg.current / msg.total) * 40);
            setProgress(pct, `${msg.current}/${msg.total}`);
            updateDeviceItem(msg.device_udid, msg.success ? 'success' : 'failed',
                msg.message, msg.videos || null, msg.cleared_count || 0);
            scrollToBottom('deviceProgressList');
            break;
        }

        // ── 索引重建 + 重启阶段（80% → 94%）──
        case 'restart_start':
            showPhaseMessage(msg.message || '开始索引重建...');
            setProgress(82);
            break;

        case 'restart_batch': {
            // 每批开始：82% + 批次进度 (0~6%)
            const batchProgress = ((msg.batch_current || 1) - 1) / (msg.batch_total || 1);
            const pct = Math.floor(82 + batchProgress * 6);
            setProgress(pct);
            showPhaseMessage(msg.message);
            // 更新设备进度条目
            if (msg.devices) {
                msg.devices.forEach(name => {
                    const deviceEls = document.querySelectorAll('#deviceProgressList .dev-status');
                    deviceEls.forEach(el => {
                        if (el.parentElement?.textContent?.includes(name)) {
                            el.textContent = '🔄 重建索引';
                            el.className = 'dev-status text-xs px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-400';
                        }
                    });
                });
            }
            break;
        }

        case 'restart_batch_done': {
            const batchProgress = (msg.batch_current || 1) / (msg.batch_total || 1);
            const pct = Math.floor(82 + batchProgress * 6);
            setProgress(pct);
            showPhaseMessage(msg.message);
            break;
        }

        case 'restart_waiting':
            showPhaseMessage(msg.message || '等待USB恢复...');
            // 根据上线设备数动态更新进度条（82%~88%）
            if (msg.online_count && msg.device_count) {
                const ratio = msg.online_count / msg.device_count;
                const pct = Math.floor(82 + ratio * 6);
                setProgress(pct);
            }
            break;

        case 'restart_final_wait':
            showPhaseMessage(msg.message || '等待设备重启...');
            setProgress(89);
            break;

        case 'restart_retry':
            showPhaseMessage(msg.message || '重试失败设备...');
            setProgress(91);
            break;

        case 'restart_done':
            showPhaseMessage(msg.message || '设备重启完成');
            setProgress(95);
            break;

        // ── 清理 + 完成 ──
        case 'cleaning':
            showPhaseMessage(msg.message || '清理本地文件...');
            setProgress(97);
            break;

        case 'task_complete':
            setProgress(100, '完成');
            showPhaseMessage('✅ 所有任务已完成！');
            showCompleteSummary(msg.summary);
            onTaskEnded();
            refreshDashboard();
            break;

        case 'task_error':
            showPhaseMessage('❌ ' + (msg.message || '发生错误'), true);
            onTaskEnded();
            break;

        case 'task_stopped':
            showPhaseMessage('⏹ 任务已手动停止');
            onTaskEnded();
            break;
    }
}

