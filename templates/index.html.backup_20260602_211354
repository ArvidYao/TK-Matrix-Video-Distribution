})();

function batchDownload() {
    var videos = getSelectedVideos();
    if (videos.length === 0) {
        alert('请先勾选要下载的视频');
        return;
    }

    // 显示进度面板
    var progressPanel = document.getElementById('batchDownloadProgress');
    progressPanel.classList.remove('hidden');
    document.getElementById('batchDownloadLog').innerHTML = '';
    document.getElementById('batchProgressBar').style.width = '0%';
    document.getElementById('batchProgressText').textContent = '0/' + videos.length;

    // 禁用按钮
    var btn = document.getElementById('batchDownloadBtn');
    btn.disabled = true;
    btn.querySelector('span').textContent = '⏳ 下载中...';

    var total = videos.length;
    var completed = 0;
    var successCount = 0;
    var failCount = 0;
    var activeDownloads = 0;
    var MAX_CONCURRENT = 3;
    var videoIndex = 0;

    function addBatchLog(msg, type) {
        var logDiv = document.getElementById('batchDownloadLog');
        var color = type === 'success' ? 'text-emerald-400' : (type === 'error' ? 'text-red-400' : 'text-slate-400');
        logDiv.innerHTML += '<div class="' + color + '">' + msg + '</div>';
        logDiv.scrollTop = logDiv.scrollHeight;
    }

    function updateProgress() {
        completed++;
        var pct = Math.round((completed / total) * 100);
        document.getElementById('batchProgressBar').style.width = pct + '%';
        document.getElementById('batchProgressText').textContent = completed + '/' + total + ' (成功:' + successCount + ' 失败:' + failCount + ')';
    }

    function finishBatch() {
        btn.disabled = false;
        btn.querySelector('span').textContent = '📥 批量下载(0)';
        document.getElementById('selectedCount').textContent = '0';
        addBatchLog('━━━━━━━━━━━━━━━━━━━', '');
        addBatchLog('批量下载完成: 成功 ' + successCount + ' 个, 失败 ' + failCount + ' 个', successCount === total ? 'success' : '');
    }

    function downloadNext() {
        while (videoIndex < total && activeDownloads < MAX_CONCURRENT) {
            var v = videos[videoIndex];
            var idx = videoIndex;
            videoIndex++;
            activeDownloads++;

            var authorName = v.author || 'unknown';
            addBatchLog('⬇ 开始下载: @' + authorName + ' ...', '');

            fetch('/api/scraper/video/download', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    video_url: v.video_url,
                    video_id: v.video_id || '',
                    save_dir: currentSaveDir || '',
                }),
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) {
                    failCount++;
                    addBatchLog('  ❌ @' + authorName + ': ' + data.message, 'error');
                    updateProgress();
                    activeDownloads--;
                    if (videoIndex < total) downloadNext();
                    else if (activeDownloads === 0) finishBatch();
                    return;
                }
                // 轮询下载状态
                var pollId = setInterval(function() {
                    var statusUrl = '/api/scraper/video/status?video_id=' + encodeURIComponent(v.video_id || '') + '&save_dir=' + encodeURIComponent(currentSaveDir || '');
                    fetch(statusUrl)
                    .then(function(r) { return r.json(); })
                    .then(function(status) {
                        if (status.status === 'done') {
                            clearInterval(pollId);
                            successCount++;
                            addBatchLog('  ✅ @' + authorName + ': ' + (status.filename || '完成'), 'success');
                            updateProgress();
                            activeDownloads--;
                            if (videoIndex < total) downloadNext();
                            else if (activeDownloads === 0) finishBatch();
                        } else if (status.status === 'error') {
                            clearInterval(pollId);
                            failCount++;
                            addBatchLog('  ❌ @' + authorName + ': ' + (status.error || '下载失败'), 'error');
                            updateProgress();
                            activeDownloads--;
                            if (videoIndex < total) downloadNext();
                            else if (activeDownloads === 0) finishBatch();
                        }
                    })
                    .catch(function() {
                        // 网络错误，继续轮询
                    });
                }, 2000);
            })
            .catch(function(err) {
                failCount++;
                addBatchLog('  ❌ @' + authorName + ': 网络错误', 'error');
                updateProgress();
                activeDownloads--;
                if (videoIndex < total) downloadNext();
                else if (activeDownloads === 0) finishBatch();
            });
        }
    }

    // 启动并发下载
    for (var n = 0; n < MAX_CONCURRENT && n < total; n++) {
        downloadNext();
    }
}

// ── 视频详情面板 ──
var currentVideoData = null;
var downloadPollTimer = null;

function openVideoDetail(video) {
    currentVideoData = video;
    var panel = document.getElementById('videoDetailPanel');
    panel.classList.remove('hidden');
    panel.scrollIntoView({behavior: 'smooth', block: 'center'});

    // 填充信息
    document.getElementById('detailDescription').textContent = video.description || '(无描述)';
    document.getElementById('detailAuthor').textContent = '@' + (video.author || '');
    document.getElementById('detailHashtag').textContent = '#' + (video.hashtag || '');
    document.getElementById('detailPlays').textContent = formatPlayCount(video.plays);
    document.getElementById('detailLikes').textContent = formatPlayCount(video.likes);
    document.getElementById('detailComments').textContent = formatPlayCount(video.comments);
    document.getElementById('detailDuration').textContent = video.duration_display || '0:00';

    // 设置链接
    var linkEl = document.getElementById('detailLink');
    linkEl.href = video.video_url || '#';

    // 加载视频预览（TikTok embed）
    var previewFrame = document.getElementById('videoPreviewFrame');
    var previewLoading = document.getElementById('videoPreviewLoading');
    previewLoading.classList.remove('hidden');
    if (video.video_id && video.author) {
        var embedUrl = 'https://www.tiktok.com/embed/v2/' + video.video_id;
        previewFrame.src = embedUrl;
    } else {
        // 尝试从视频 URL 中提取 ID
        var match = (video.video_url || '').match(/\/video\/(\d+)/);
        if (match) {
            previewFrame.src = 'https://www.tiktok.com/embed/v2/' + match[1];
        } else {
            previewFrame.src = '';
            previewLoading.innerHTML = '<div class="text-center"><span class="text-4xl">🎬</span><p class="text-xs text-slate-500 mt-2">暂无可预览</p></div>';
        }
    }
    previewFrame.onload = function() {
        previewLoading.classList.add('hidden');
    };

    // 重置下载状态
    resetDownloadUI();
}

function closeVideoDetail() {
    document.getElementById('videoDetailPanel').classList.add('hidden');
    document.getElementById('videoPreviewFrame').src = '';
    if (downloadPollTimer) { clearInterval(downloadPollTimer); downloadPollTimer = null; }
    currentVideoData = null;
}

function resetDownloadUI() {
    document.getElementById('downloadProgress').classList.add('hidden');
    document.getElementById('downloadResult').classList.add('hidden');
    var btn = document.getElementById('detailDownloadBtn');
    btn.disabled = false;
    btn.className = 'flex items-center gap-1.5 text-sm bg-violet-600 hover:bg-violet-500 text-white rounded-lg px-5 py-2.5 font-medium transition-all';
    document.getElementById('downloadBtnIcon').textContent = '📥';
    document.getElementById('downloadBtnText').textContent = '下载视频素材';
    if (downloadPollTimer) { clearInterval(downloadPollTimer); downloadPollTimer = null; }
}

function downloadVideo() {
    if (!currentVideoData) return;

    var btn = document.getElementById('detailDownloadBtn');
    btn.disabled = true;
    btn.className = 'flex items-center gap-1.5 text-sm bg-slate-600 text-slate-300 rounded-lg px-5 py-2.5 font-medium cursor-not-allowed';
    document.getElementById('downloadBtnIcon').textContent = '⏳';
    document.getElementById('downloadBtnText').textContent = '准备下载...';

    // 显示进度条
    var progressDiv = document.getElementById('downloadProgress');
    progressDiv.classList.remove('hidden');
    document.getElementById('downloadProgressBar').style.width = '10%';
    document.getElementById('downloadProgressText').textContent = '初始化...';

    fetch('/api/scraper/video/download', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            video_url: currentVideoData.video_url,
            video_id: currentVideoData.video_id || '',
            save_dir: currentSaveDir || '',
        }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (!data.success) {
            showDownloadError(data.message);
            return;
        }
        // 轮询下载状态
        document.getElementById('downloadProgressBar').style.width = '25%';
        document.getElementById('downloadProgressText').textContent = '下载中...';
        document.getElementById('downloadBtnText').textContent = '下载中...';

        pollDownloadStatus(currentVideoData.video_id || '');
    })
    .catch(function(err) {
        showDownloadError('网络错误: ' + err.message);
    });
}

function pollDownloadStatus(videoId) {
    var dots = 0;
    downloadPollTimer = setInterval(function() {
        var statusUrl = '/api/scraper/video/status?video_id=' + encodeURIComponent(videoId) + '&save_dir=' + encodeURIComponent(currentSaveDir || '');
        fetch(statusUrl)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.status === 'done') {
                // 下载完成
                clearInterval(downloadPollTimer);
                downloadPollTimer = null;
                document.getElementById('downloadProgressBar').classList.remove('animate-pulse');
                document.getElementById('downloadProgressBar').style.width = '100%';
                document.getElementById('downloadProgressText').textContent = '下载完成!';

                showDownloadSuccess(data.filename, data.filepath);
            } else if (data.status === 'error') {
                clearInterval(downloadPollTimer);
                downloadPollTimer = null;
                showDownloadError(data.error || '下载失败');
            } else if (data.status === 'downloading') {
                // 模拟进度（实际 yt-dlp 不提供详细进度，通过抖动表示工作中）
                dots = (dots + 1) % 4;
                var loadingText = '下载中' + '.'.repeat(dots);
                document.getElementById('downloadProgressText').textContent = loadingText;
                var currentWidth = parseInt(document.getElementById('downloadProgressBar').style.width) || 25;
                if (currentWidth < 90) {
                    document.getElementById('downloadProgressBar').style.width = (currentWidth + 0.5) + '%';
                }
            } else if (data.status === 'not_found') {
                clearInterval(downloadPollTimer);
                downloadPollTimer = null;
                showDownloadError('下载任务未找到');
            }
        })
        .catch(function() {
            // 轮询失败，继续尝试
        });
    }, 1500);
}

function showDownloadSuccess(filename, filepath) {
    var resultDiv = document.getElementById('downloadResult');
    resultDiv.classList.remove('hidden');
    resultDiv.className = 'mt-2 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg';
    resultDiv.innerHTML =
        '<div class="flex items-center justify-between">' +
        '<div class="flex items-center gap-2">' +
        '<span class="text-emerald-400 text-sm">✅</span>' +
        '<span class="text-xs text-emerald-300">已保存: <span class="font-mono text-emerald-200">' + (filename || '') + '</span></span>' +
        '</div>' +
        '<button onclick="revealInFinder(\'' + (filepath || '').replace(/'/g, "\\'") + '\')" class="text-xs text-emerald-400 hover:text-emerald-300 underline">在访达中显示</button>' +
        '</div>';

    // 恢复按钮
    var btn = document.getElementById('detailDownloadBtn');
    btn.disabled = false;
    btn.className = 'flex items-center gap-1.5 text-sm bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg px-5 py-2.5 font-medium transition-all';
    document.getElementById('downloadBtnIcon').textContent = '✅';
    document.getElementById('downloadBtnText').textContent = '下载完成';

    document.getElementById('downloadProgress').classList.add('hidden');
}

function showDownloadError(message) {
    var resultDiv = document.getElementById('downloadResult');
    resultDiv.classList.remove('hidden');
    resultDiv.className = 'mt-2 p-3 bg-red-500/10 border border-red-500/30 rounded-lg';
    resultDiv.innerHTML =
        '<div class="flex items-center gap-2">' +
        '<span class="text-red-400 text-sm">❌</span>' +
        '<span class="text-xs text-red-300">下载失败: ' + (message || '未知错误') + '</span>' +
        '</div>';

    // 恢复按钮
    var btn = document.getElementById('detailDownloadBtn');
    btn.disabled = false;
    btn.className = 'flex items-center gap-1.5 text-sm bg-violet-600 hover:bg-violet-500 text-white rounded-lg px-5 py-2.5 font-medium transition-all';
    document.getElementById('downloadBtnIcon').textContent = '🔄';
    document.getElementById('downloadBtnText').textContent = '重试下载';

    document.getElementById('downloadProgress').classList.add('hidden');
}

function revealInFinder(filepath) {
    // 通过后端 API 在访达中打开
    fetch('/api/scraper/video/list')
    .then(function(r) { return r.json(); })
    .then(function(data) {
        alert('文件已保存至: downloads/videos/' + (filepath ? filepath.split('/').pop() : ''));
    });
}

function exportCSV() {
    fetch('/api/scraper/results')
    .then(r => r.json())
    .then(data => {
        var results = (currentResultTab === 'all') ? (data.all_results || []) : (data.results || data.qualified || []);
        if (results.length === 0) {
            alert('没有可导出的数据');
            return;
        }

        // BOM + CSV
        var bom = '\uFEFF';
        var header = '标签,视频链接,作者,描述,播放量,点赞,评论,分享,时长(秒),时长,发布时间\n';
        var rows = results.map(function(v) {
            return [
                v.hashtag, v.video_url, v.author,
                '"' + (v.description || '').replace(/"/g, '""') + '"',
                v.plays, v.likes, v.comments, v.shares,
                v.duration_sec, v.duration_display, v.create_time
            ].join(',');
        }).join('\n');

        var blob = new Blob([bom + header + rows], {type: 'text/csv;charset=utf-8'});
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'tiktok_hot_' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
        URL.revokeObjectURL(url);
    });
}
