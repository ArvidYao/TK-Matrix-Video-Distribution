async function refreshDashboard() {
    try {
        const data = await api('GET', '/api/status');

        document.getElementById('dash-devices').textContent = '--';
        document.getElementById('dash-videos').textContent = data.video_count || 0;
        document.getElementById('dash-today').textContent = data.today_sessions || 0;
        document.getElementById('dash-total').textContent = data.total_distributed || 0;
        document.getElementById('dash-today-success').textContent = data.today_success || 0;
        document.getElementById('dash-today-fail').textContent = data.today_fail || 0;
        document.getElementById('dash-video-size').textContent = data.video_total_size_human || '0 MB';

        // 更新顶部状态徽章
        updateStatusBadge(data.running);

        // 最后一次记录
        const historyData = await api('GET', '/api/history');
        if (historyData.sessions && historyData.sessions.length > 0) {
            const last = historyData.sessions[0];
            const timeStr = last.timestamp ? new Date(last.timestamp).toLocaleString('zh-CN') : '';
            document.getElementById('dash-last-session').innerHTML = `
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between"><span class="text-slate-400">时间</span><span>${timeStr}</span></div>
