function getCurrentTags() {
    var text = document.getElementById('scraperHashtags').value;
    if (!text.trim()) return [];
    return text.split('\n').map(function(s) { return s.trim(); }).filter(function(s) { return s; });
}

function toggleHashtag(tag, clickedEl) {
    // 支持两种调用方式：直接传标签名 或 从元素 data-tag 读取
    if (typeof tag === 'object' && tag !== null && tag.getAttribute) {
        clickedEl = tag;
        tag = clickedEl.getAttribute('data-tag');
    }
    if (!tag) return;

    var textarea = document.getElementById('scraperHashtags');
    var currentTags = getCurrentTags();
    var tagIndex = currentTags.indexOf(tag);

    // 点击动画反馈
    if (clickedEl) {
        clickedEl.classList.remove('popping');
        void clickedEl.offsetWidth; // 强制回流
        clickedEl.classList.add('popping');
    }

    if (tagIndex >= 0) {
        // 标签已存在 → 移除
        currentTags.splice(tagIndex, 1);
        textarea.value = currentTags.join('\n');
        // 短暂闪烁红色表示移除了
        if (clickedEl) {
            var origBg = clickedEl.style.backgroundColor;
            clickedEl.style.backgroundColor = 'rgba(239,68,68,0.3)';
            clickedEl.style.borderColor = 'rgba(239,68,68,0.5)';
            setTimeout(function() {
                clickedEl.style.backgroundColor = '';
                clickedEl.style.borderColor = '';
            }, 300);
        }
    } else {
        // 标签不存在 → 追加到末尾
        currentTags.push(tag);
        textarea.value = currentTags.join('\n');
        // 短暂闪烁绿色表示添加了
        if (clickedEl) {
            var origBg2 = clickedEl.style.backgroundColor;
            clickedEl.style.backgroundColor = 'rgba(16,185,129,0.3)';
            clickedEl.style.borderColor = 'rgba(16,185,129,0.5)';
            setTimeout(function() {
                clickedEl.style.backgroundColor = '';
                clickedEl.style.borderColor = '';
            }, 300);
        }
    }

    // 触发自动保存
    autoSaveHashtags();
    // 刷新历史列表的视觉状态
    refreshHistoryHighlights();
    // 聚焦文本区域，滚动到底部
    textarea.focus();
    textarea.scrollTop = textarea.scrollHeight;
}

function refreshHistoryHighlights() {
    var currentTags = getCurrentTags();
    var currentSet = {};
    currentTags.forEach(function(t) { currentSet[t] = true; });

    var tagEls = document.querySelectorAll('#hashtagHistory .history-tag');
    tagEls.forEach(function(el) {
        var tagName = el.getAttribute('data-tag');
        if (currentSet[tagName]) {
            el.classList.add('active');
            el.classList.remove('inactive');
        } else {
            el.classList.remove('active');
            el.classList.add('inactive');
        }
    });
}

function loadHistory() {
    fetch('/api/scraper/hashtags/history')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var container = document.getElementById('hashtagHistory');
            var countEl = document.getElementById('historyCount');
            var history = data.history || [];
            countEl.textContent = '(' + history.length + ')';

            if (history.length === 0) {
                container.innerHTML = '<div class="text-xs text-slate-600 italic">暂无修改记录</div>';
                return;
            }

            // 获取当前对话框中已有的标签集合
            var currentTags = getCurrentTags();
            var currentSet = {};
            currentTags.forEach(function(t) { currentSet[t] = true; });

            // 倒序显示（最新的在上面）
            var reversed = history.slice().reverse();
            var html = '';
            reversed.forEach(function(entry, idx) {
                var isLatest = idx === 0;
                html += '<div class="py-1.5 px-2 rounded ' + (isLatest ? 'bg-slate-700/60' : 'hover:bg-slate-700/30') + ' transition-colors">';
                // 时间线头部
                html += '<div class="flex items-center gap-1.5 mb-1.5">';
                html += '<span class="' + (isLatest ? 'text-emerald-400' : 'text-slate-500') + ' text-[10px]">' + (isLatest ? '●' : '○') + '</span>';
                html += '<span class="text-[10px] text-slate-500">' + entry.timestamp + ' · ' + entry.count + ' 个</span>';
                html += '</div>';
                // 可点击的标签列表
                html += '<div class="flex flex-wrap gap-1">';
                entry.hashtags.forEach(function(tag) {
                    var isActive = currentSet[tag];
                    var activeClass = isActive ? 'active' : 'inactive';
                    var icon = isActive ? '✓' : '+';
                    var escapedTag = escapeHtml(tag);
                    html += '<span class="history-tag ' + activeClass + ' inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] border"';
                    html += ' data-tag="' + tag.replace(/"/g, '&quot;') + '"';
                    html += ' onclick="toggleHashtag(this)"';
                    html += ' title="' + (isActive ? '点击从输入框移除 ' : '点击添加到输入框 ') + escapedTag + '">';
                    html += '<span class="tag-icon">' + icon + '</span> #' + escapedTag;
                    html += '</span>';
                });
                html += '</div>';
                html += '</div>';
            });
            container.innerHTML = html;
        });
}

