// 自动保存：防抖 1 秒
var hashtagSaveTimer = null;
var lastSavedValue = '';
var savedHashtagsCache = [];

function autoSaveHashtags() {
    if (hashtagSaveTimer) clearTimeout(hashtagSaveTimer);
    updateSaveStatus('waiting');
    hashtagSaveTimer = setTimeout(function() {
        doSaveHashtags();
    }, 1000);
}

function doSaveHashtags() {
    var text = document.getElementById('scraperHashtags').value.trim();
    var hashtags = text ? text.split('\n').map(function(s) { return s.trim(); }).filter(function(s) { return s; }) : [];
    if (hashtags.length === 0) return;

    // 与上次相同则跳过
    var currentValue = hashtags.join('\n');
    if (currentValue === lastSavedValue) {
        updateSaveStatus('saved');
        return;
    }

    updateSaveStatus('saving');
    fetch('/api/scraper/hashtags/save', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({hashtags: hashtags}),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success && !data.skipped) {
            lastSavedValue = currentValue;
            updateSaveStatus('saved');
            savedHashtagsCache = hashtags;
            document.getElementById('btnLoadSaved').classList.remove('hidden');
            loadHistory();  // 刷新历史列表
        } else if (data.skipped) {
            updateSaveStatus('saved');
        } else {
            updateSaveStatus('error');
        }
    })
    .catch(function() {
        updateSaveStatus('error');
    });
}

function updateSaveStatus(state) {
    var el = document.getElementById('saveStatus');
    var dot = el.querySelector('span');
    if (state === 'waiting') {
        el.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-yellow-400 inline-block animate-pulse"></span> 等待保存';
    } else if (state === 'saving') {
        el.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-blue-400 inline-block animate-pulse"></span> 保存中...';
    } else if (state === 'saved') {
        el.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> 已自动保存';
        setTimeout(function() {
            var statEl = document.getElementById('saveStatus');
            if (statEl && statEl.textContent.indexOf('已自动保存') >= 0) {
                statEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-slate-600 inline-block"></span> 就绪';
            }
        }, 3000);
    } else if (state === 'error') {
        el.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-red-400 inline-block"></span> 保存失败';
    }
}

function loadSavedHashtags() {
    if (savedHashtagsCache.length > 0) {
