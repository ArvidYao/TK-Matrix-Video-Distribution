// ============================================================
// 分发任务
// ============================================================
async function startDistribute() {
    const dryRun = document.getElementById('dryRunToggle').checked;

    try {
        // 先重置UI、建立SSE连接，再触发任务（避免错过早期进度消息）
        isRunning = true;
        onTaskStarted();
        connectSSE();

        const res = await api('POST', '/api/distribute/start', { dry_run: dryRun });
        if (res.error) {
            showToast(res.error, 'error');
            onTaskEnded();
            return;
        }
        // 记录当前任务ID，用于过滤旧消息
        currentTaskId = res.task_id || null;
        showToast(dryRun ? '模拟模式已启动 🧪' : '分发任务已开始 🚀', 'info');

    } catch (e) {
        showToast('启动失败: ' + e.message, 'error');
        onTaskEnded();
    }
}

async function stopDistribute() {
    try {
        await api('POST', '/api/distribute/stop');
        showToast('已发送停止信号...', 'warning');
    } catch (e) {
        showToast('停止失败: ' + e.message, 'error');
    }
